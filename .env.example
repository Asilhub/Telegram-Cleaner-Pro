# Telegram API Ma'lumotlari (https://my.telegram.org saytidan olinadi)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# Chatlarni o'chirish oralig'idagi kechikish (soniyalarda, FloodWait xatolarining oldini olish uchun)
DELETE_DELAY_SECONDS=1.2

# O'chirishda ikkala tomondan ham o'chirilsinmi (True = ikkala tomondan o'chirish, False = faqat o'zidan)
REVOKE_FOR_ALL=True

# O'chirilmasligi kerak bo'lgan ID yoki Username'lar (vergul bilan ajratilgan)
# Masalan: 12345678,durov,username123
WHITELIST=
